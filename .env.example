# ──────────────────────────────────────────────────────────
# MitraKu AI — Environment Configuration
# Salin file ini menjadi .env dan isi nilainya
# ──────────────────────────────────────────────────────────

# ── [WAJIB] AI Provider ───────────────────────────────────

# Google Gemini API Key
# Dapatkan di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# [Opsional] Groq API Key (AI fallback lebih cepat)
# Dapatkan di: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# [Opsional] OpenRouter API Key
# Dapatkan di: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Port Server ───────────────────────────────────────────
PORT=3000

# ── Database PostgreSQL (digunakan oleh Docker) ───────────
POSTGRES_USER=mitraku_admin
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=mitraku_db
