{
  "id": "mitraku-rag-chat-flow-v1",
  "name": "MitraKu — Toko Pintar RAG Chat Flow",
  "description": "Flow B: Menerima query pelanggan dari widget CS, vector search ke Astra DB katalog toko, Gemini menjawab berdasarkan konteks produk yang relevan. Endpoint utama Modul 1 Toko Pintar AI.",
  "data": {
    "edges": [
      {
        "id": "edge-chat-to-astra-search",
        "source": "ChatInput-query",
        "sourceHandle": "{\"dataType\":\"ChatInput\",\"id\":\"ChatInput-query\",\"name\":\"message\",\"output_types\":[\"Message\"]}",
        "target": "AstraDB-search",
        "targetHandle": "{\"fieldName\":\"search_query\",\"id\":\"AstraDB-search\",\"inputTypes\":[\"Message\"],\"type\":\"query\"}"
      },
      {
        "id": "edge-embed-to-astra-search",
        "source": "GoogleEmbeddings-search",
        "sourceHandle": "{\"dataType\":\"Google Generative AI Embeddings\",\"id\":\"GoogleEmbeddings-search\",\"name\":\"embeddings\",\"output_types\":[\"Embeddings\"]}",
        "target": "AstraDB-search",
        "targetHandle": "{\"fieldName\":\"embedding_model\",\"id\":\"AstraDB-search\",\"inputTypes\":[\"Embeddings\"],\"type\":\"other\"}"
      },
      {
        "id": "edge-astra-to-parsedata",
        "source": "AstraDB-search",
        "sourceHandle": "{\"dataType\":\"AstraDB\",\"id\":\"AstraDB-search\",\"name\":\"search_results\",\"output_types\":[\"Data\"]}",
        "target": "ParseData-context",
        "targetHandle": "{\"fieldName\":\"data\",\"id\":\"ParseData-context\",\"inputTypes\":[\"Data\"],\"type\":\"other\"}"
      },
      {
        "id": "edge-parsedata-to-prompt",
        "source": "ParseData-context",
        "sourceHandle": "{\"dataType\":\"ParseData\",\"id\":\"ParseData-context\",\"name\":\"text\",\"output_types\":[\"Message\"]}",
        "target": "PromptTemplate-cs",
        "targetHandle": "{\"fieldName\":\"context\",\"id\":\"PromptTemplate-cs\",\"inputTypes\":[\"Message\"],\"type\":\"str\"}"
      },
      {
        "id": "edge-chat-to-prompt",
        "source": "ChatInput-query",
        "sourceHandle": "{\"dataType\":\"ChatInput\",\"id\":\"ChatInput-query\",\"name\":\"message\",\"output_types\":[\"Message\"]}",
        "target": "PromptTemplate-cs",
        "targetHandle": "{\"fieldName\":\"question\",\"id\":\"PromptTemplate-cs\",\"inputTypes\":[\"Message\"],\"type\":\"str\"}"
      },
      {
        "id": "edge-memory-to-prompt",
        "source": "Memory-session",
        "sourceHandle": "{\"dataType\":\"Memory\",\"id\":\"Memory-session\",\"name\":\"messages_text\",\"output_types\":[\"Message\"]}",
        "target": "PromptTemplate-cs",
        "targetHandle": "{\"fieldName\":\"history\",\"id\":\"PromptTemplate-cs\",\"inputTypes\":[\"Message\"],\"type\":\"str\"}"
      },
      {
        "id": "edge-prompt-to-llm",
        "source": "PromptTemplate-cs",
        "sourceHandle": "{\"dataType\":\"Prompt Template\",\"id\":\"PromptTemplate-cs\",\"name\":\"prompt\",\"output_types\":[\"Message\"]}",
        "target": "GeminiLLM-response",
        "targetHandle": "{\"fieldName\":\"input_value\",\"id\":\"GeminiLLM-response\",\"inputTypes\":[\"Message\"],\"type\":\"str\"}"
      },
      {
        "id": "edge-llm-to-output",
        "source": "GeminiLLM-response",
        "sourceHandle": "{\"dataType\":\"LanguageModelComponent\",\"id\":\"GeminiLLM-response\",\"name\":\"text_output\",\"output_types\":[\"Message\"]}",
        "target": "ChatOutput-answer",
        "targetHandle": "{\"fieldName\":\"input_value\",\"id\":\"ChatOutput-answer\",\"inputTypes\":[\"Data\",\"DataFrame\",\"Message\"],\"type\":\"other\"}"
      }
    ],
    "nodes": [
      {
        "id": "ChatInput-query",
        "type": "genericNode",
        "position": { "x": 50, "y": 400 },
        "data": {
          "id": "ChatInput-query",
          "type": "ChatInput",
          "node": {
            "display_name": "💬 Query Pelanggan",
            "description": "Pertanyaan dari pelanggan yang masuk ke widget CS Toko Pintar. Session ID diisi dengan store_id untuk isolasi per toko.",
            "template": {
              "input_value": {
                "_input_type": "MultilineInput",
                "display_name": "Pertanyaan Pelanggan",
                "name": "input_value",
                "value": ""
              },
              "session_id": {
                "_input_type": "StrInput",
                "display_name": "Session ID (store_id)",
                "name": "session_id",
                "info": "Isi dengan store_id UMKM (misal: default, toko_budi). Digunakan untuk isolasi riwayat chat per toko.",
                "value": "default"
              },
              "sender_name": {
                "_input_type": "StrInput",
                "display_name": "Sender Name",
                "name": "sender_name",
                "value": "Pelanggan"
              }
            },
            "outputs": [
              {
                "display_name": "Message",
                "method": "message_response",
                "name": "message",
                "selected": "Message",
                "types": ["Message"]
              }
            ]
          }
        }
      },
      {
        "id": "GoogleEmbeddings-search",
        "type": "genericNode",
        "position": { "x": 400, "y": 150 },
        "data": {
          "id": "GoogleEmbeddings-search",
          "type": "GoogleGenerativeAIEmbeddings",
          "node": {
            "display_name": "🧠 Google Gemini Embeddings (Search)",
            "description": "Embed query pelanggan untuk vector similarity search ke Astra DB.",
            "template": {
              "google_api_key": {
                "_input_type": "SecretStrInput",
                "display_name": "Google API Key",
                "name": "google_api_key",
                "load_from_db": true,
                "value": "GEMINI_API_KEY"
              },
              "model": {
                "_input_type": "DropdownInput",
                "display_name": "Model",
                "name": "model",
                "options": ["models/text-embedding-004", "models/embedding-001"],
                "value": "models/text-embedding-004"
              }
            },
            "outputs": [
              {
                "display_name": "Embeddings",
                "method": "build_embeddings",
                "name": "embeddings",
                "selected": "Embeddings",
                "types": ["Embeddings"]
              }
            ]
          }
        }
      },
      {
        "id": "AstraDB-search",
        "type": "genericNode",
        "position": { "x": 400, "y": 400 },
        "data": {
          "id": "AstraDB-search",
          "type": "AstraDB",
          "node": {
            "display_name": "🔍 Astra DB — Vector Search Katalog",
            "description": "Cari produk yang relevan dengan query pelanggan dari vector store. Filter by store_id untuk isolasi data antar toko UMKM.",
            "template": {
              "token": {
                "_input_type": "SecretStrInput",
                "display_name": "Astra DB Token",
                "name": "token",
                "load_from_db": true,
                "value": "ASTRA_DB_APPLICATION_TOKEN"
              },
              "api_endpoint": {
                "_input_type": "StrInput",
                "display_name": "API Endpoint",
                "name": "api_endpoint",
                "value": "ASTRA_DB_API_ENDPOINT"
              },
              "collection_name": {
                "_input_type": "StrInput",
                "display_name": "Collection Name",
                "name": "collection_name",
                "value": "mitraku_catalog"
              },
              "number_of_results": {
                "_input_type": "IntInput",
                "display_name": "Number of Results",
                "name": "number_of_results",
                "info": "Ambil 5 produk paling relevan untuk diberikan sebagai konteks ke AI.",
                "value": 5
              }
            },
            "outputs": [
              {
                "display_name": "Search Results",
                "method": "search_documents",
                "name": "search_results",
                "selected": "Data",
                "types": ["Data"]
              }
            ]
          }
        }
      },
      {
        "id": "ParseData-context",
        "type": "genericNode",
        "position": { "x": 700, "y": 400 },
        "data": {
          "id": "ParseData-context",
          "type": "ParseData",
          "node": {
            "display_name": "📋 Parse Konteks Produk",
            "description": "Format hasil search Astra DB menjadi teks yang bisa dibaca LLM sebagai konteks RAG.",
            "template": {
              "template": {
                "_input_type": "MultilineInput",
                "display_name": "Template",
                "name": "template",
                "value": "{text}"
              },
              "sep": {
                "_input_type": "StrInput",
                "display_name": "Separator",
                "name": "sep",
                "value": "\n---\n"
              }
            },
            "outputs": [
              {
                "display_name": "Text",
                "method": "parse_data",
                "name": "text",
                "selected": "Message",
                "types": ["Message"]
              }
            ]
          }
        }
      },
      {
        "id": "Memory-session",
        "type": "genericNode",
        "position": { "x": 700, "y": 150 },
        "data": {
          "id": "Memory-session",
          "type": "Memory",
          "node": {
            "display_name": "🧠 Riwayat Percakapan",
            "description": "Simpan dan load riwayat chat per session_id (store_id). Pelanggan bisa tanya lanjutan tanpa kehilangan konteks.",
            "template": {
              "session_id": {
                "_input_type": "MessageTextInput",
                "display_name": "Session ID",
                "name": "session_id",
                "info": "Diisi otomatis dari ChatInput session_id",
                "value": ""
              },
              "memory_key": {
                "_input_type": "StrInput",
                "display_name": "Memory Key",
                "name": "memory_key",
                "value": "chat_history"
              },
              "n_messages": {
                "_input_type": "IntInput",
                "display_name": "Number of Messages",
                "name": "n_messages",
                "info": "Jumlah pesan terakhir yang diingat. 10 pesan = 5 giliran tanya jawab.",
                "value": 10
              }
            },
            "outputs": [
              {
                "display_name": "Chat History",
                "method": "retrieve_messages_as_text",
                "name": "messages_text",
                "selected": "Message",
                "types": ["Message"]
              }
            ]
          }
        }
      },
      {
        "id": "PromptTemplate-cs",
        "type": "genericNode",
        "position": { "x": 1000, "y": 300 },
        "data": {
          "id": "PromptTemplate-cs",
          "type": "PromptTemplate",
          "node": {
            "display_name": "📝 Prompt CS Template",
            "description": "Template prompt untuk Customer Service AI. Menggabungkan konteks produk dari RAG + riwayat chat + pertanyaan pelanggan.",
            "template": {
              "template": {
                "_input_type": "PromptInput",
                "display_name": "Template",
                "name": "template",
                "value": "Kamu adalah Customer Service AI resmi 24/7 yang ramah dan profesional.\n\nKATALOG PRODUK TOKO (hasil pencarian relevan):\n{context}\n\nRIWAYAT PERCAKAPAN SEBELUMNYA:\n{history}\n\nATURAN PENTING:\n1. Jawab pertanyaan pelanggan HANYA berdasarkan data katalog produk di atas.\n2. Jika produk yang ditanyakan tidak ada di konteks, katakan dengan sopan: \"Mohon maaf Kak, produk tersebut belum ada di katalog toko kami saat ini.\"\n3. Selalu sapa pelanggan dengan \"Kak\", gunakan Bahasa Indonesia yang ramah dan membantu.\n4. Berikan info harga yang tepat dengan format Rupiah (Rp).\n5. Jika stok 0, informasikan dengan jelas dan tawarkan untuk dihubungi saat restock.\n\nPERTANYAAN PELANGGAN:\n{question}\n\nJAWABAN CS AI:"
              },
              "context": {
                "_input_type": "HandleInput",
                "display_name": "Konteks Produk",
                "name": "context",
                "input_types": ["Message"],
                "value": ""
              },
              "history": {
                "_input_type": "HandleInput",
                "display_name": "Riwayat Chat",
                "name": "history",
                "input_types": ["Message"],
                "value": ""
              },
              "question": {
                "_input_type": "HandleInput",
                "display_name": "Pertanyaan",
                "name": "question",
                "input_types": ["Message"],
                "value": ""
              }
            },
            "outputs": [
              {
                "display_name": "Prompt",
                "method": "build_prompt",
                "name": "prompt",
                "selected": "Message",
                "types": ["Message"]
              }
            ]
          }
        }
      },
      {
        "id": "GeminiLLM-response",
        "type": "genericNode",
        "position": { "x": 1300, "y": 300 },
        "data": {
          "id": "GeminiLLM-response",
          "type": "LanguageModelComponent",
          "node": {
            "display_name": "⚡ Gemini 2.0 Flash — CS AI",
            "description": "LLM yang menjawab pertanyaan pelanggan berdasarkan konteks RAG dari Astra DB. Model Gemini 2.0 Flash untuk respons cepat.",
            "template": {
              "model_name": {
                "_input_type": "DropdownInput",
                "display_name": "Model",
                "name": "model_name",
                "options": ["gemini-2.0-flash", "gemini-2.5-flash", "gemini-1.5-flash"],
                "value": "gemini-2.0-flash"
              },
              "google_api_key": {
                "_input_type": "SecretStrInput",
                "display_name": "Google API Key",
                "name": "google_api_key",
                "load_from_db": true,
                "value": "GEMINI_API_KEY"
              },
              "temperature": {
                "_input_type": "FloatInput",
                "display_name": "Temperature",
                "name": "temperature",
                "info": "Rendah (0.3) = lebih faktual, cocok untuk CS yang harus akurat.",
                "value": 0.3
              },
              "max_output_tokens": {
                "_input_type": "IntInput",
                "display_name": "Max Output Tokens",
                "name": "max_output_tokens",
                "value": 1024
              }
            },
            "outputs": [
              {
                "display_name": "Text Output",
                "method": "text_response",
                "name": "text_output",
                "selected": "Message",
                "types": ["Message"]
              }
            ]
          }
        }
      },
      {
        "id": "ChatOutput-answer",
        "type": "genericNode",
        "position": { "x": 1600, "y": 300 },
        "data": {
          "id": "ChatOutput-answer",
          "type": "ChatOutput",
          "node": {
            "display_name": "✅ Jawaban CS",
            "description": "Output jawaban Customer Service yang akan dikembalikan ke widget pelanggan dan MitraKu API.",
            "template": {
              "sender_name": {
                "_input_type": "StrInput",
                "display_name": "Sender Name",
                "name": "sender_name",
                "value": "CS Toko Pintar AI"
              },
              "should_store_message": {
                "_input_type": "BoolInput",
                "display_name": "Store Message",
                "name": "should_store_message",
                "info": "Simpan pesan ke memory untuk konteks percakapan berikutnya.",
                "value": true
              }
            },
            "outputs": [
              {
                "display_name": "Message",
                "method": "message_response",
                "name": "message",
                "selected": "Message",
                "types": ["Message"]
              }
            ]
          }
        }
      }
    ]
  },
  "_mitraku_notes": {
    "cara_pakai": "1) Import file ini ke Langflow UI localhost:7860. 2) Set ASTRA_DB_APPLICATION_TOKEN dan ASTRA_DB_API_ENDPOINT. 3) Copy Flow ID dari URL, paste ke .env sebagai LANGFLOW_RAG_FLOW_ID. 4) Pastikan collection 'mitraku_catalog' sudah ada di Astra DB (buat dari Ingestion Flow dulu).",
    "endpoint_format": "POST http://localhost:7860/api/v1/run/<LANGFLOW_RAG_FLOW_ID> dengan body: { input_value: '<query pelanggan>', session_id: '<store_id>', tweaks: {} }",
    "response_path": "response.outputs[0].outputs[0].results.message.text",
    "session_isolation": "Session ID = store_id — setiap toko UMKM punya riwayat percakapan terpisah di Langflow Memory"
  }
}
