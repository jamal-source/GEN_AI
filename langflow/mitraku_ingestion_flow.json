{
  "id": "mitraku-ingestion-flow-v1",
  "name": "MitraKu — Toko Pintar Ingestion Flow",
  "description": "Flow A: Menerima data produk katalog UMKM dari MitraKu API, embed dengan Google Gemini, simpan ke Astra DB. Dipanggil setiap kali produk ditambah atau dihapus dari katalog.",
  "data": {
    "edges": [
      {
        "id": "edge-textin-splitter",
        "source": "TextInput-catalog",
        "sourceHandle": "{\"dataType\":\"TextInput\",\"id\":\"TextInput-catalog\",\"name\":\"text\",\"output_types\":[\"Message\"]}",
        "target": "SplitText-chunks",
        "targetHandle": "{\"fieldName\":\"data_input\",\"id\":\"SplitText-chunks\",\"inputTypes\":[\"Message\",\"Data\"],\"type\":\"other\"}"
      },
      {
        "id": "edge-splitter-astra",
        "source": "SplitText-chunks",
        "sourceHandle": "{\"dataType\":\"SplitText\",\"id\":\"SplitText-chunks\",\"name\":\"dataframe\",\"output_types\":[\"DataFrame\"]}",
        "target": "AstraDB-ingest",
        "targetHandle": "{\"fieldName\":\"ingest_data\",\"id\":\"AstraDB-ingest\",\"inputTypes\":[\"Data\",\"DataFrame\"],\"type\":\"other\"}"
      },
      {
        "id": "edge-embed-astra",
        "source": "GoogleEmbeddings-ingest",
        "sourceHandle": "{\"dataType\":\"Google Generative AI Embeddings\",\"id\":\"GoogleEmbeddings-ingest\",\"name\":\"embeddings\",\"output_types\":[\"Embeddings\"]}",
        "target": "AstraDB-ingest",
        "targetHandle": "{\"fieldName\":\"embedding_model\",\"id\":\"AstraDB-ingest\",\"inputTypes\":[\"Embeddings\"],\"type\":\"other\"}"
      }
    ],
    "nodes": [
      {
        "id": "TextInput-catalog",
        "type": "genericNode",
        "position": { "x": 100, "y": 300 },
        "data": {
          "id": "TextInput-catalog",
          "type": "TextInput",
          "node": {
            "display_name": "📦 Input Katalog Produk",
            "description": "Menerima teks JSON produk dari MitraKu API. Format: JSON string berisi id, name, category, price, stock, description, shipping_info, store_id",
            "template": {
              "input_value": {
                "_input_type": "MultilineInput",
                "display_name": "Product JSON Text",
                "info": "JSON string produk dari endpoint /api/toko-pintar/catalog. Dikirim oleh MitraKu server saat produk ditambah/diupdate.",
                "name": "input_value",
                "required": true,
                "type": "str",
                "value": ""
              }
            },
            "outputs": [
              {
                "display_name": "Text",
                "method": "text_response",
                "name": "text",
                "selected": "Message",
                "types": ["Message"]
              }
            ]
          }
        }
      },
      {
        "id": "SplitText-chunks",
        "type": "genericNode",
        "position": { "x": 450, "y": 300 },
        "data": {
          "id": "SplitText-chunks",
          "type": "SplitText",
          "node": {
            "display_name": "✂️ Text Splitter",
            "description": "Memecah teks produk menjadi chunks kecil untuk di-embed. Chunk size kecil karena data produk sudah terstruktur.",
            "template": {
              "chunk_size": {
                "_input_type": "IntInput",
                "display_name": "Chunk Size",
                "name": "chunk_size",
                "value": 500
              },
              "chunk_overlap": {
                "_input_type": "IntInput",
                "display_name": "Chunk Overlap",
                "name": "chunk_overlap",
                "value": 50
              },
              "separator": {
                "_input_type": "StrInput",
                "display_name": "Separator",
                "name": "separator",
                "value": "\n"
              }
            },
            "outputs": [
              {
                "display_name": "Chunks",
                "method": "split_text",
                "name": "dataframe",
                "selected": "DataFrame",
                "types": ["DataFrame"]
              }
            ]
          }
        }
      },
      {
        "id": "GoogleEmbeddings-ingest",
        "type": "genericNode",
        "position": { "x": 450, "y": 100 },
        "data": {
          "id": "GoogleEmbeddings-ingest",
          "type": "GoogleGenerativeAIEmbeddings",
          "node": {
            "display_name": "🧠 Google Gemini Embeddings",
            "description": "Generate embedding vector dari teks produk menggunakan Google Generative AI. API Key diambil dari environment variable.",
            "template": {
              "google_api_key": {
                "_input_type": "SecretStrInput",
                "display_name": "Google API Key",
                "name": "google_api_key",
                "load_from_db": true,
                "value": "GEMINI_API_KEY"
              },
              "model": {
                "_input_type": "DropdownInput",
                "display_name": "Model",
                "name": "model",
                "options": ["models/text-embedding-004", "models/embedding-001"],
                "value": "models/text-embedding-004"
              }
            },
            "outputs": [
              {
                "display_name": "Embeddings",
                "method": "build_embeddings",
                "name": "embeddings",
                "selected": "Embeddings",
                "types": ["Embeddings"]
              }
            ]
          }
        }
      },
      {
        "id": "AstraDB-ingest",
        "type": "genericNode",
        "position": { "x": 850, "y": 300 },
        "data": {
          "id": "AstraDB-ingest",
          "type": "AstraDB",
          "node": {
            "display_name": "🗄️ Astra DB — Simpan Katalog",
            "description": "Simpan embedding produk ke Astra DB vector store. Collection: mitraku_catalog. Metadata store_id digunakan untuk filter per toko.",
            "template": {
              "token": {
                "_input_type": "SecretStrInput",
                "display_name": "Astra DB Token",
                "name": "token",
                "load_from_db": true,
                "value": "ASTRA_DB_APPLICATION_TOKEN"
              },
              "api_endpoint": {
                "_input_type": "StrInput",
                "display_name": "API Endpoint",
                "name": "api_endpoint",
                "info": "Ambil dari Astra DB dashboard. Format: https://<db-id>-<region>.apps.astra.datastax.com",
                "value": "ASTRA_DB_API_ENDPOINT"
              },
              "collection_name": {
                "_input_type": "StrInput",
                "display_name": "Collection Name",
                "name": "collection_name",
                "value": "mitraku_catalog"
              },
              "deletion_field": {
                "_input_type": "StrInput",
                "display_name": "Deletion Field",
                "name": "deletion_field",
                "info": "Hapus dokumen lama dengan store_id yang sama sebelum insert baru — pastikan data selalu fresh.",
                "value": "store_id"
              }
            },
            "outputs": [
              {
                "display_name": "Vector Store",
                "method": "as_vector_store",
                "name": "vectorstoreconnection",
                "selected": "VectorStore",
                "types": ["VectorStore"]
              }
            ]
          }
        }
      }
    ]
  },
  "_mitraku_notes": {
    "cara_pakai": "1) Buka Langflow UI di localhost:7860. 2) Import file JSON ini via menu Upload Flow. 3) Set env var ASTRA_DB_APPLICATION_TOKEN dan ASTRA_DB_API_ENDPOINT. 4) Copy Flow ID dari URL setelah import, paste ke .env sebagai LANGFLOW_INGESTION_FLOW_ID.",
    "trigger": "Flow ini dipanggil otomatis oleh MitraKu server setiap kali UMKM menambah atau menghapus produk dari endpoint POST/DELETE /api/toko-pintar/catalog",
    "collection": "mitraku_catalog — buat collection ini di Astra DB dengan dimensi 768 (text-embedding-004)"
  }
}
