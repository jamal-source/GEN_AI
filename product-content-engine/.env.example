# PRODUCT CONTENT AUTOMATION ENGINE - ENVIRONMENT CONFIGURATION

# Application Environment
NODE_ENV=production
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

# Database Settings (PostgreSQL)
POSTGRES_USER=pce_admin
POSTGRES_PASSWORD=pce_secure_password_2026
POSTGRES_DB=product_content_db
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# n8n Service Settings
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
GENERIC_TIMEZONE=Asia/Jakarta

# AI Worker Settings
OLLAMA_BASE_URL=http://localhost:11434
PYTHON_WORKER_PORT=8000

# Google Drive Service Account
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/google_service_account.json
