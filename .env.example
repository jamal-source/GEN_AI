# Google Gemini API Key (Dari Google AI Studio: https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Dari Groq Console: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Port Server
PORT=3000

# n8n Webhook URL (Opsional)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/product-content-pipeline

# Database Configuration (Opsional / Docker)
POSTGRES_USER=pce_admin
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=product_content_db
